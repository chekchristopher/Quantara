rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'chekchris85@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'enterpriseTier', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.role in ['operator', 'senior_analyst', 'risk_officer', 'admin'] &&
        data.enterpriseTier in ['Standard', 'Institutional Pro', 'Enterprise Dedicated'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 300000)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 1024)) &&
        (!('desk' in data) || (data.desk is string && data.desk.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidRiskSettings(data) {
      return data.keys().hasAll(['id', 'userId', 'maxRiskPerTradePercent', 'maxDailyLossPercent', 'maxWeeklyLossPercent', 'maxAccountDrawdownPercent', 'maxOpenPositions', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.maxRiskPerTradePercent is number && data.maxRiskPerTradePercent >= 0.1 && data.maxRiskPerTradePercent <= 10.0 &&
        data.maxDailyLossPercent is number && data.maxDailyLossPercent >= 0.5 && data.maxDailyLossPercent <= 25.0 &&
        data.maxWeeklyLossPercent is number && data.maxWeeklyLossPercent >= 1.0 && data.maxWeeklyLossPercent <= 50.0 &&
        data.maxAccountDrawdownPercent is number && data.maxAccountDrawdownPercent >= 1.0 && data.maxAccountDrawdownPercent <= 50.0 &&
        data.maxOpenPositions is number && data.maxOpenPositions >= 1 && data.maxOpenPositions <= 50 &&
        (!('maxExposurePerAssetPercent' in data) || (data.maxExposurePerAssetPercent is number && data.maxExposurePerAssetPercent <= 100.0)) &&
        (!('maxPortfolioExposurePercent' in data) || (data.maxPortfolioExposurePercent is number && data.maxPortfolioExposurePercent <= 100.0)) &&
        (!('maxLeverage' in data) || (data.maxLeverage is number && data.maxLeverage <= 500.0)) &&
        (!('trailingStopEnabled' in data) || data.trailingStopEnabled is bool) &&
        (!('trailingStopPercent' in data) || (data.trailingStopPercent is number && data.trailingStopPercent <= 20.0)) &&
        (!('killSwitchActive' in data) || data.killSwitchActive is bool) &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidBrokerProfile(data) {
      return data.keys().hasAll(['id', 'userId', 'brokerName', 'accountNumber', 'server', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.brokerName is string && data.brokerName.size() <= 128 &&
        data.accountNumber is string && data.accountNumber.size() <= 64 &&
        data.server is string && data.server.size() <= 128 &&
        data.status is string && data.status.size() <= 32 &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 32)) &&
        (!('environment' in data) || (data.environment is string && data.environment.size() <= 32)) &&
        (!('balance' in data) || data.balance is number) &&
        (!('simulatedBalance' in data) || data.simulatedBalance is number) &&
        (!('equity' in data) || data.equity is number) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 16)) &&
        (!('leverage' in data) || (data.leverage is string && data.leverage.size() <= 32) || data.leverage is number) &&
        (!('isCompoundingActive' in data) || data.isCompoundingActive is bool) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
        (!('broker' in data) || (data.broker is string && data.broker.size() <= 128)) &&
        (!('accountType' in data) || (data.accountType is string && data.accountType.size() <= 32)) &&
        (!('isPaper' in data) || data.isPaper is bool) &&
        (!('apiKeyMasked' in data) || (data.apiKeyMasked is string && data.apiKeyMasked.size() <= 64)) &&
        (!('permissions' in data) || data.permissions is list) &&
        (!('lastConnected' in data) || data.lastConnected is number) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTradingJournal(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'direction', 'entryPrice', 'quantity', 'status', 'openedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.symbol is string && data.symbol.size() <= 32 &&
        data.direction is string && data.direction.size() <= 16 &&
        data.entryPrice is number &&
        data.quantity is number &&
        data.status is string && data.status.size() <= 32 &&
        (!('strategyId' in data) || (data.strategyId is string && data.strategyId.size() <= 64)) &&
        (!('exitPrice' in data) || data.exitPrice is number) &&
        (!('pnlUsd' in data) || data.pnlUsd is number) &&
        (!('realizedPnl' in data) || data.realizedPnl is number) &&
        (!('pnlPercent' in data) || data.pnlPercent is number) &&
        (!('realizedPnlPercent' in data) || data.realizedPnlPercent is number) &&
        (!('strategyName' in data) || (data.strategyName is string && data.strategyName.size() <= 128)) &&
        (!('marketRegime' in data) || (data.marketRegime is string && data.marketRegime.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1024)) &&
        data.openedAt is string && data.openedAt.size() <= 64 &&
        (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 64));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'category', 'action']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        (!('level' in data) || (data.level is string && data.level.size() <= 32)) &&
        (!('severity' in data) || (data.severity is string && data.severity.size() <= 32)) &&
        data.category is string && data.category.size() <= 64 &&
        data.action is string && data.action.size() <= 128 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 2048));
    }

    // --- Collections & Paths ---

    // Diagnostics & Connection Probe
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == userId &&
        incoming().email == request.auth.token.email &&
        (incoming().role == 'operator' || isAdmin()) &&
        (incoming().enterpriseTier == 'Standard' || isAdmin());

      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        (isAdmin() || (
          incoming().role == existing().role &&
          incoming().enterpriseTier == existing().enterpriseTier
        ));

      allow delete: if isAdmin();

      // Subcollection: Risk Settings
      match /settings/{settingId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(settingId);
        allow list: if isSignedIn() && isOwner(userId);
        
        allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(settingId) &&
          incoming().userId == userId &&
          isValidRiskSettings(incoming());
          
        allow delete: if isAdmin();
      }

      // Subcollection: Broker Accounts & MT5 Credentials
      match /brokers/{brokerId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(brokerId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(brokerId) &&
          incoming().userId == userId &&
          isValidBrokerProfile(incoming());

        allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(brokerId) &&
          incoming().userId == userId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          isValidBrokerProfile(incoming());

        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(brokerId);
      }

      // Subcollection: Trading Journal & Performance
      match /journal/{tradeId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(tradeId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(tradeId) &&
          incoming().userId == userId &&
          isValidTradingJournal(incoming());

        allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(tradeId) &&
          incoming().userId == userId &&
          incoming().id == existing().id &&
          incoming().openedAt == existing().openedAt &&
          isValidTradingJournal(incoming());

        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(tradeId);
      }

      // Subcollection: Audit Logs (Immutable)
      match /auditLogs/{logId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(logId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
          isValidId(userId) && isValidId(logId) &&
          incoming().userId == userId &&
          isValidAuditLog(incoming());

        // Immutable compliance audit trail: no updates or deletes allowed
        allow update, delete: if false;
      }
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
