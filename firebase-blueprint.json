{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Enterprise user identity, access role, and organization tier.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 300000 },
        "bio": { "type": "string", "maxLength": 1024 },
        "desk": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["operator", "senior_analyst", "risk_officer", "admin"] },
        "enterpriseTier": { "type": "string", "enum": ["Standard", "Institutional Pro", "Enterprise Dedicated"] },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "role", "enterpriseTier", "createdAt", "updatedAt"]
    },
    "UserRiskSettings": {
      "title": "UserRiskSettings",
      "description": "Deterministic institutional risk parameters configured per operator.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "maxRiskPerTradePercent": { "type": "number" },
        "maxDailyLossPercent": { "type": "number" },
        "maxWeeklyLossPercent": { "type": "number" },
        "maxAccountDrawdownPercent": { "type": "number" },
        "maxOpenPositions": { "type": "number" },
        "maxExposurePerAssetPercent": { "type": "number" },
        "maxPortfolioExposurePercent": { "type": "number" },
        "maxLeverage": { "type": "number" },
        "trailingStopEnabled": { "type": "boolean" },
        "trailingStopPercent": { "type": "number" },
        "killSwitchActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "maxRiskPerTradePercent", "maxDailyLossPercent", "maxWeeklyLossPercent", "maxAccountDrawdownPercent", "maxOpenPositions", "updatedAt"]
    },
    "UserBrokerProfile": {
      "title": "UserBrokerProfile",
      "description": "Connected MT5 or institutional broker account configuration and secure server link.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "brokerName": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "server": { "type": "string", "maxLength": 128 },
        "serverHost": { "type": "string", "maxLength": 128 },
        "protocol": { "type": "string", "maxLength": 32 },
        "encryptionLevel": { "type": "string", "maxLength": 64 },
        "securityHash": { "type": "string", "maxLength": 128 },
        "platform": { "type": "string", "maxLength": 32 },
        "environment": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "currency": { "type": "string", "maxLength": 16 },
        "leverage": { "type": "string", "maxLength": 32 },
        "isCompoundingActive": { "type": "boolean" },
        "serverStatus": { "type": "string", "maxLength": 32 },
        "isNonStop": { "type": "boolean" },
        "savedInSystem": { "type": "boolean" },
        "isSecuredInFirebase": { "type": "boolean" },
        "uptimeSeconds": { "type": "number" },
        "totalTradesExecuted": { "type": "number" },
        "winningTradesCount": { "type": "number" },
        "losingTradesCount": { "type": "number" },
        "winRatePercent": { "type": "number" },
        "profitFactor": { "type": "number" },
        "lotsTradedTotal": { "type": "number" },
        "netRealizedPnl": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "brokerName", "accountNumber", "server", "status", "createdAt", "updatedAt"]
    },
    "UserServerTrade": {
      "title": "UserServerTrade",
      "description": "Chronological trade execution performed on a specific connected broker server.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serverId": { "type": "string", "maxLength": 128 },
        "serverName": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "symbol": { "type": "string", "maxLength": 32 },
        "side": { "type": "string", "maxLength": 16 },
        "lotSize": { "type": "number" },
        "quantity": { "type": "number" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "realizedPnl": { "type": "number" },
        "realizedPnlPercent": { "type": "number" },
        "feesPaid": { "type": "number" },
        "strategyName": { "type": "string", "maxLength": 128 },
        "exitReason": { "type": "string", "maxLength": 32 },
        "tradeExplanation": { "type": "string", "maxLength": 1024 },
        "entryTime": { "type": "string", "maxLength": 64 },
        "exitTime": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "serverId", "symbol", "side", "entryPrice", "exitPrice", "realizedPnl", "createdAt"]
    },
    "UserServerReport": {
      "title": "UserServerReport",
      "description": "Institutional account report detailing all performance and trade executions for a connected server.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serverId": { "type": "string", "maxLength": 128 },
        "serverName": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "generatedAt": { "type": "string", "maxLength": 64 },
        "initialBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "totalEquity": { "type": "number" },
        "netProfitUsd": { "type": "number" },
        "returnPercent": { "type": "number" },
        "totalTrades": { "type": "number" },
        "winningTrades": { "type": "number" },
        "losingTrades": { "type": "number" },
        "winRatePercent": { "type": "number" },
        "profitFactor": { "type": "number" },
        "totalLotsTraded": { "type": "number" },
        "averageLotSize": { "type": "number" },
        "maxDrawdownPercent": { "type": "number" },
        "reportSummary": { "type": "string", "maxLength": 2048 }
      },
      "required": ["id", "userId", "serverId", "serverName", "accountNumber", "generatedAt", "totalTrades", "netProfitUsd"]
    },
    "UserTradingJournal": {
      "title": "UserTradingJournal",
      "description": "Persistent trade record, execution metrics, and operator notes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "direction": { "type": "string", "maxLength": 16 },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "pnlUsd": { "type": "number" },
        "pnlPercent": { "type": "number" },
        "strategyId": { "type": "string", "maxLength": 64 },
        "strategyName": { "type": "string", "maxLength": 128 },
        "marketRegime": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 4096 },
        "disciplineRating": { "type": "number" },
        "emotionalState": { "type": "string", "maxLength": 64 },
        "followedPlan": { "type": "string", "maxLength": 64 },
        "mistakeTags": { "type": "array", "items": { "type": "string" } },
        "subjectiveNotes": { "type": "string", "maxLength": 4096 },
        "lessonsLearned": { "type": "string", "maxLength": 2048 },
        "targetSetupQuality": { "type": "string", "maxLength": 16 },
        "psychologyReviewCompleted": { "type": "boolean" },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "openedAt": { "type": "string", "maxLength": 64 },
        "closedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "symbol", "direction", "entryPrice", "quantity", "strategyId", "status", "openedAt"]
    },
    "UserAuditLog": {
      "title": "UserAuditLog",
      "description": "Immutable telemetry and compliance audit events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1024 }
      },
      "required": ["id", "userId", "timestamp", "level", "category", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user identity and enterprise authorization credentials."
    },
    "/users/{userId}/settings/risk": {
      "schema": "UserRiskSettings",
      "description": "Risk management configuration and circuit breaker limits for the user."
    },
    "/users/{userId}/brokers/{brokerId}": {
      "schema": "UserBrokerProfile",
      "description": "MT5 and broker profiles connected to the user's workspace."
    },
    "/users/{userId}/brokers/{brokerId}/trades/{tradeId}": {
      "schema": "UserServerTrade",
      "description": "Complete audit trail of all trades executed for this connected server."
    },
    "/users/{userId}/brokers/{brokerId}/reports/{reportId}": {
      "schema": "UserServerReport",
      "description": "Comprehensive enterprise account reports generated for this connected server."
    },
    "/users/{userId}/journal/{tradeId}": {
      "schema": "UserTradingJournal",
      "description": "Trade log journal, executed orders, and performance tracking."
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "UserAuditLog",
      "description": "Immutable compliance and security logs generated during trading sessions."
    }
  }
}
